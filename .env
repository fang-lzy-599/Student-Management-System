
# ===== 数据库连接（按本机 MySQL 修改） =====
DB_HOST=127.0.0.1            # 数据库主机地址（本机 MySQL，用 127.0.0.1 避免 localhost 解析到 IPv6）
DB_PORT=3306                 # 数据库端口（MySQL 默认 3306）
DB_USER=root                 # 数据库用户名
DB_PASSWORD=123456           # 数据库密码（开发默认，生产务必改）
DB_NAME=school_db_wanhe            # 数据库名（init.sql 创建）
